          "functionCode": "// 处理数据\nconst processedData = items.map(item => {\n  return {\n    id: item.json.id,\n    name: item.json.name,\n    processed_at: new Date().toISOString()\n  };\n});\n\nreturn processedData.map(data => ({ json: data }));"
